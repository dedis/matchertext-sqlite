+      if( rc!=SQLITE_OK ){
+        sqlite3_finalize(*ppStmt);
+        *ppStmt = 0;
+        goto matchertext_prepare_out;
+      }
+    }
+  }
+
+matchertext_prepare_out:
+  if( pOut ) sqlite3_free(sqlite3_str_finish(pOut));
+  sqlite3DbFree(db, zCopy);
+  sqlite3_free(zSql);
+  rc = sqlite3ApiExit(db, rc);
+  sqlite3_mutex_leave(db->mutex);
+  return rc;
+}
+#endif
