+    int tokenType;
+    int nToken = sqlite3GetToken((const u8*)zTail, &tokenType);
+    if( tokenType!=TK_SPACE && tokenType!=TK_COMMENT && tokenType!=TK_SEMI ){
+      sqlite3_finalize(*ppStmt);
